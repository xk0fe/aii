#!/bin/sh
# Claude Code runs each command an agent gives it through this (CLAUDE_CODE_SHELL_PREFIX), as the leader of the command's
# own process group, with the command as one argument. Writing the group down lets Crew find what the command leaves
# running (a dev server started with &, a simulator helper) once the agent is done (core/procs.js). Then the command
# runs as it would have: in your shell, or through your own prefix if you have one.
[ -n "$CREW_GROUPS" ] && echo "$$ $(date +%s)" >> "$CREW_GROUPS" 2>/dev/null
[ -n "$CREW_SHELL_PREFIX" ] && exec "$CREW_SHELL_PREFIX" "$@"
[ $# -gt 1 ] && exec "$@"
exec "${CLAUDE_CODE_SHELL:-${SHELL:-/bin/sh}}" -c "$1"
