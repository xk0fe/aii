{
  "expo": {
    "name": "Crew",
    "slug": "crew",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crew",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4f4f7",
    "ios": {
      "bundleIdentifier": "app.crew.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Crew talks to Crew on your Mac over your network, to show your crew and send your answers.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.crew.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EEE4F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f4f7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#161719",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Crew uses the camera to scan the pairing code your Mac shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
