<!-- crew-voice.exe: Crew's dictation helper on Windows (Program.cs). A self-contained folder, no .NET install needed:
       dotnet publish desktop/native/windows/CrewVoice -c Release -r win-x64 -o <out>     (or -r win-arm64)
     then put the speech model in <out>/models/ (see Program.cs). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>crew-voice</AssemblyName>
    <RootNamespace>CrewVoice</RootNamespace>
    <Product>Crew</Product>
    <Description>Crew's on-device dictation</Description>
    <!-- language names ("Русский") come from the culture data -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Published for one Windows (or, to try it, Mac) architecture: everything it needs in one folder, trimmed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!-- The default x64 build of whisper.cpp needs AVX; Whisper.net falls back to this one on PCs without it
       (low-end Celeron and Pentium Silver laptops). -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>

  <!-- Whisper.net's runtimes copy whisper.cpp for every platform they know into runtimes/; keep only this one's. -->
  <Target Name="CrewVoiceOnlyThisPlatform" BeforeTargets="AssignTargetPaths" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_CrewPlatform>$(RuntimeIdentifier.Replace('osx-', 'macos-'))</_CrewPlatform>
    </PropertyGroup>
    <ItemGroup>
      <_CrewNative Include="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').Replace('\', '/').StartsWith('runtimes/'))" />
      <_CrewOther Include="@(_CrewNative)" Condition="!$([System.String]::Copy('%(_CrewNative.TargetPath)').Replace('\', '/').StartsWith('runtimes/$(_CrewPlatform)/')) And !$([System.String]::Copy('%(_CrewNative.TargetPath)').Replace('\', '/').StartsWith('runtimes/noavx/$(_CrewPlatform)/'))" />
      <None Remove="@(_CrewOther)" />
      <None Remove="@(None)" Condition="'%(Filename)%(Extension)' == 'ggml-metal.metal' And !$(RuntimeIdentifier.StartsWith('osx-'))" />
    </ItemGroup>
  </Target>

  <!-- What a helper that never debugs, dumps or speaks HTTP/3 doesn't need from the .NET runtime (about 8 MB). -->
  <Target Name="CrewVoiceSlim" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <ItemGroup>
      <_CrewUnused Include="$(PublishDir)createdump.exe;$(PublishDir)mscordbi.dll;$(PublishDir)mscordaccore*.dll;$(PublishDir)Microsoft.DiaSymReader.Native.*.dll;$(PublishDir)msquic.dll" />
    </ItemGroup>
    <Delete Files="@(_CrewUnused)" />
  </Target>

</Project>
