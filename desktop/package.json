{
  "name": "clique",
  "productName": "CLIque",
  "version": "1.0.0",
  "private": true,
  "description": "CLIque: a team of AI coding agents (Claude Code, Codex) with names, jobs and one chat for all of them",
  "author": {
    "name": "Greengrass"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/build-app.mjs --open",
    "dev": "electron .",
    "test": "node --test --import ./test/helpers/clis.mjs test/*.test.js",
    "postinstall": "node scripts/postinstall.mjs",
    "app": "node scripts/build-app.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:mac": "node scripts/dist.mjs --mac",
    "dist:win": "node scripts/dist.mjs --win",
    "voice": "node scripts/build-voice.mjs",
    "icon": "electron scripts/make-icon.mjs && electron scripts/make-ico.mjs",
    "shots": "electron scripts/screenshots.mjs",
    "probe:sandbox": "electron scripts/sandbox-probe.mjs",
    "probe:composer": "electron scripts/composer-probe.mjs",
    "readme": "node scripts/readme.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clique-shared": "file:../shared",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.18.0"
  }
}
